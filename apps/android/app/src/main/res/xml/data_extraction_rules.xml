<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing this app holds may leave the device through backup or transfer.
     Received files are staged in app-private storage before they are verified
     and exported, messages live only in memory, and session keys are per link —
     none of it is state a restore could legitimately reconstitute, and all of it
     is content the user chose to move between two devices they were holding. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
