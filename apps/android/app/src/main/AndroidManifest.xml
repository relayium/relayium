<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Everything this app does needs the network and nothing else. No
         storage permission: files are read and written through the system
         document picker, which grants access per document. No contacts, no
         location, no notifications, no background service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Direct APK distribution: no Play Services, no Play Billing, and nothing
         in this manifest requires either. -->

    <application
        android:name=".RelayiumApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Relayium">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opening a relayium.com join link.

                 Deliberately NOT `android:autoVerify="true"`. Verified App Links
                 need an assetlinks.json served from the production origin, which
                 is a server change outside this task's scope; claiming
                 verification without it produces a link that silently never
                 routes. The truthful consequence: on Android 12+ an unverified
                 https filter does NOT intercept taps — links open in the
                 browser — and this filter matters only when the user pastes
                 the link or enables "open supported links" manually in the
                 app's settings. There is no ACTION_SEND handler in this
                 stage, so sharing a link INTO the app is not an entry point
                 this build offers. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="relayium.com" android:pathPrefix="/cross-network" />
            </intent-filter>
        </activity>
    </application>
</manifest>
