<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The same nine languages the app declares, and for the same reason: the
	     catalogs live in the RelayiumShareKit package bundle rather than in this
	     one, so without this list iOS treats the extension as English-only. It
	     would render correct Arabic words — the package bundle answers for them —
	     while laying the sheet out left to right, because
	     UIApplication.userInterfaceLayoutDirection is decided from the BUNDLE's
	     localizations. Every Arabic screen would then read correctly and be laid
	     out backwards. An extension has its own bundle, so it needs its own copy
	     of this list; keep in step with AppLanguage and with the app's
	     Info.plist. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ko</string>
		<string>de</string>
		<string>fr</string>
		<string>ar</string>
		<string>es</string>
		<string>pt</string>
	</array>
	<!-- Required, and required by `installd` rather than by any build step. An
	     appex without a non-empty `CFBundleDisplayName` is refused at INSTALL
	     time with MIInstallerErrorDomain 53, which fails the containing app's
	     install too — so the whole product is uninstallable and no archive,
	     export or simulator run says a word about it. `CFBundleName` does not
	     substitute: it is `$(PRODUCT_NAME)` = "RelayiumShare", and the check is
	     for this key specifically.

	     "Relayium" and not "RelayiumShare", because this string IS the share
	     sheet entry the user taps. The target name is a build artifact; what
	     belongs in the sheet is the app the files are going to.

	     Not localized, and not a `$(...)` substitution. A brand name is the same
	     in all nine languages this bundle declares, so an `InfoPlist.strings`
	     per language would be nine copies of one word — and the catalogs this
	     extension uses live in the RelayiumShareKit package bundle, not here,
	     so a key looked up in THIS bundle would find nothing to vary anyway. -->
	<key>CFBundleDisplayName</key>
	<string>Relayium</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- A DICTIONARY rule, never `NSExtensionActivationRule` =
			     `TRUEPREDICATE`.

			     `TRUEPREDICATE` is the default Xcode template's value and it means
			     "offer Relayium in every share sheet on the device" — including
			     for a selected sentence, a URL, a web page, a contact and a
			     calendar event, none of which this extension can stage. An entry
			     that appears everywhere and fails on most of them is worse than
			     an entry that appears where it works.

			     Four keys, four counts, and no text or web key at all:

			      - `SupportsFileWithMaxCount` — documents from Files and from any
			        app that vends `public.data`/`public.content`, which is also
			        how a shared folder arrives.
			      - `SupportsImageWithMaxCount` / `SupportsMovieWithMaxCount` —
			        the Photos app's two kinds.
			      - `SupportsAttachmentsWithMaxCount` — the AGGREGATE, which Apple
			        documents as the maximum total number of attachments. The
			        three per-type maxima are each satisfiable on their own, so
			        without this a mixed share of 1000 files, 1000 images and 1000
			        movies would satisfy all three and hand this extension 3000
			        items — three times a bound the product enforces everywhere
			        else. This is the key that makes the total the same number.

			     Every count is `MAX_FILES`, which is the manifest bound the whole
			     product enforces, so the sheet never accepts a share this app
			     would have to refuse afterwards. `SupportsText`, `SupportsWebURL`
			     and `SupportsWebPage` are deliberately absent: sharing a link or
			     a paragraph to Relayium would produce a text file the user never
			     asked for. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsAttachmentsWithMaxCount</key>
				<integer>1000</integer>
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>1000</integer>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>1000</integer>
				<key>NSExtensionActivationSupportsMovieWithMaxCount</key>
				<integer>1000</integer>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<!-- A principal class, not a storyboard. `NSExtensionMainStoryboard`
		     would be the template's default and would put this surface in a
		     file no test can read and no localization guard can scan. -->
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
	</dict>
</dict>
</plist>
