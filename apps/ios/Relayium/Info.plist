<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The same nine languages the macOS app declares, and for the same
	     reason: the catalogs live in the RelayiumAppKit package bundle rather
	     than in this one, so without this list iOS treats the app as
	     English-only. It would render correct Arabic words — the package
	     bundle answers for them — while leaving the app's user-interface
	     layout direction left to right, because
	     UIApplication.userInterfaceLayoutDirection is decided from the APP
	     bundle's localizations and is what SwiftUI's \.layoutDirection
	     follows. Every Arabic screen would then read correctly and be laid out
	     backwards. Keep in step with AppLanguage; LocalizationIntegrityTests
	     asserts the two agree. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ko</string>
		<string>de</string>
		<string>fr</string>
		<string>ar</string>
		<string>es</string>
		<string>pt</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The two keys that make the app-owned Documents folder a real place the
	     user can reach. Received transfers land in Documents/Received, and
	     these publish that directory as "On My iPhone ▸ Relayium" in the Files
	     app: browsable, movable, deletable without this app. Without them the
	     files would exist inside a container nothing else can open, which for
	     a receive app is the same as not having saved them. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Present and empty on purpose: an iOS app without a launch-screen
	     declaration is letterboxed at a legacy size rather than run at the
	     device's native resolution. Empty means the system's default, which is
	     what a single-screen app that has no launch imagery wants. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
