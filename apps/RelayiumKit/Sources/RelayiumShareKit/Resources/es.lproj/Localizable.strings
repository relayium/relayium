/* MARK: 1.1.2 — help, below the controls on every browseable destination */
"help.heading" = "Ayuda";
"help.stepsHeading" = "Cómo funciona";
"help.guideLink" = "Leer la guía en relayium.com";

"help.lan.step1" = "Abre Relayium en ambos dispositivos y mantenlos en la misma red.";
"help.lan.step2" = "Elige el otro dispositivo de la lista y envía un mensaje o los archivos que hayas añadido.";
"help.lan.step3" = "Si la verificación está activada, comprueba que ambas pantallas muestran el mismo código antes de aceptar.";
"help.lan.question" = "¿Los archivos pasan por los servidores de Relayium?";
"help.lan.answer" = "No. El servicio de Relayium solo pone en contacto a los dos dispositivos; una vez conectados, los archivos viajan directamente entre ellos.";

"help.cross.step1" = "En este dispositivo, crea un código para un mensaje o para archivos.";
"help.cross.step2" = "Escribe ese código en Relayium en el otro dispositivo y únete.";
"help.cross.step3" = "Comprueba que ambas pantallas muestran el mismo código y acepta la transferencia.";
"help.cross.question" = "¿Los dos dispositivos tienen que estar en la misma red?";
"help.cross.answer" = "No: para eso está esta pantalla. Crear un código requiere una cuenta, porque la conexión puede tener que retransmitirse y eso se le factura a quien la creó. Unirse al código de otra persona no requiere nada.";

"help.storedSend.step1" = "Elige archivos o carpetas, decide cuánto tiempo debe seguir funcionando el enlace y envía.";
"help.storedSend.step2" = "Relayium cifra todo en este Mac antes de subir nada.";
"help.storedSend.step3" = "Comparte el enlace. La clave que lo abre viaja dentro del propio enlace y nunca llega a Relayium.";
"help.storedSend.question" = "¿Quién puede abrir el enlace?";
"help.storedSend.answer" = "Cualquiera que tenga el enlace completo, incluida la parte posterior al #. Relayium solo guarda el archivo cifrado y no puede leerlo, así que trata el propio enlace como un secreto.";

"help.inbox.step1" = "Inicia sesión con la misma cuenta aquí y en el dispositivo desde el que quieras enviar.";
"help.inbox.step2" = "Elige una carpeta en este Mac y decide si las entregas se guardan automáticamente o esperan tu respuesta.";
"help.inbox.step3" = "Envía a este Mac desde relayium.com o desde otro dispositivo con la sesión iniciada, y los archivos llegarán a esa carpeta.";
"help.inbox.question" = "¿Qué ocurre mientras este Mac duerme o Relayium está cerrado?";
"help.inbox.answer" = "Las entregas esperan en el servidor hasta que Relayium vuelva a ejecutarse aquí. Solo puede recibir mientras está en ejecución, y para eso sirve el ajuste de inicio de sesión de arriba.";

"help.account.step1" = "Crea una cuenta o inicia sesión: enviar un enlace y la bandeja del dispositivo necesitan una.";
"help.account.step2" = "Consulta qué plan tienes y cuánto has consumido en este periodo.";
"help.account.step3" = "Revisa los dispositivos con sesión iniciada en tu cuenta y los archivos que has almacenado, y elimina unos u otros.";
"help.account.question" = "¿Qué necesita una cuenta y qué no?";
"help.account.answer" = "La transferencia en la misma red y unirse a un código creado por otra persona no necesitan cuenta. Crear un código, enviar un enlace almacenado y la bandeja del dispositivo sí la necesitan.";
