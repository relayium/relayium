<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build's Info.plist.

     It is the direct download's file with Sparkle's three keys removed —
     `SUFeedURL`, `SUPublicEDKey` and `SUEnableInstallerLauncherService` — and
     nothing else changed. A feed URL in an App Store build is a promise to
     download and run code Apple did not review, which is the reason the App
     Store forbids a second update mechanism at all; the other two are the
     signing key and the installer-launcher switch that only serve it.

     Everything else is deliberately IDENTICAL, including the two declared
     localizations, the document types that make this app a Dock drop target and
     a Finder "Open With" entry, and the app category. Each is argued at length
     in `Relayium/Info.plist`; the reasoning is not repeated here so there is one
     place to correct it. Keep the two files in step — a divergence between them
     is a difference between two products users think are the same one, and
     `StoreKitLinkageTests` compares them key for key. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Exactly the two languages the app ships, and the same list as the
	     direct Mac target's Info.plist. This is also the set App Store Connect
	     reads to decide which localizations the product page may advertise, so
	     a stale entry here is a public claim, not just a runtime one. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>File or folder to send</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
</dict>
</plist>
