<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- WebRTC does not merely dial out: ICE binds UDP sockets and has to
	     receive the peer's connectivity checks arriving unsolicited. Under the
	     App Sandbox that is an inbound connection, and network.client alone
	     does not permit it — so host and server-reflexive candidates are
	     silently dead and the only path left is a relay. Signalling is plain
	     outbound TCP and works either way, which is why the app reached the
	     hub, minted a code and paired, then failed at the transfer. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Sparkle's installer runs outside the app sandbox. These narrowly scoped
	     Mach service names are the communication channel documented by Sparkle
	     for its required Installer.xpc service. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:relayium.com</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.relayium.shared</string>
	</array>
	<!-- The other half of the Share extension's hand-off. The extension copies
	     what the user shared into this container; without the same entitlement
	     here the app's `containerURL(forSecurityApplicationGroupIdentifier:)`
	     returns nil and every shared draft is a copy of the user's files that
	     nothing will ever show them.

	     Written out rather than `$(TeamIdentifierPrefix)…` so it is the same
	     literal `AppGroup.macOSIdentifier` holds and `MacSurfaceGuardTests`
	     compares; a substitution would make the two impossible to check against
	     each other without re-implementing Xcode's expansion in a test.

	     NOT iOS's `group.com.relayium.app`. The macOS provisioning profiles
	     authorize `group.com.relayium.shared` and the team-prefixed wildcard
	     `7PVYUG4YQS.*` and never iOS's string, and Apple documents the macOS
	     form of an App Group identifier as `<team>.<group>`. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>7PVYUG4YQS.com.relayium.shared</string>
	</array>
</dict>
</plist>
