<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The nine languages this app ships, declared here because the catalogs
	     themselves live in the RelayiumAppKit package bundle rather than in this
	     one. Without this list macOS treats the app as English-only: it would
	     pick English as the app localization for an Arabic user, and — the part
	     that actually breaks the UI — leave the app's user-interface layout
	     direction left-to-right, so SwiftUI's \.layoutDirection would never
	     become .rightToLeft and every Arabic screen would be laid out backwards
	     while reading correctly. Keep in step with AppLanguage; the release
	     readiness script checks the two agree. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ko</string>
		<string>de</string>
		<string>fr</string>
		<string>ar</string>
		<string>es</string>
		<string>pt</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://relayium.com/apps/macos/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>AoA0oNo2cZzjIJ4CJgnaFUhy3EAucSxcM+/iayLux6k=</string>
</dict>
</plist>
