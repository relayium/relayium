<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The nine languages this app ships. The catalogs live in the
	     RelayiumAppKit package bundle rather than this bundle, so the list keeps
	     the app's declared localizations in step with AppLanguage. The macOS
	     scene also applies that resolved language's layout direction explicitly:
	     CFBundleLocalizations alone did not mirror a package-backed Arabic UI on
	     a real build. The release-readiness script checks this list. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ko</string>
		<string>de</string>
		<string>fr</string>
		<string>ar</string>
		<string>es</string>
		<string>pt</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- Written by hand rather than left to actool's partial-plist merge. With
	     GENERATE_INFOPLIST_FILE = NO and a hand-maintained INFOPLIST_FILE, the
	     key would otherwise arrive only by that merge — and a silent failure of
	     it is indistinguishable from a missing icon. One line makes the
	     acceptance check unambiguous. The name matches
	     ASSETCATALOG_COMPILER_APPICON_NAME in both build configurations. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- What makes Relayium a Dock drop target and a Finder "Open With" entry.
	     Without it the app has no way in from outside its own window, which is
	     the native advantage a desktop app has over the website and the reason
	     this exists at all.

	     `LSHandlerRank` = `None` is the load-bearing line, not boilerplate. The
	     content types below are `public.data` and `public.folder` — deliberately
	     everything, because "send this" is not a format question and a list of
	     extensions would be a list of the files a user may NOT send. Declaring
	     that breadth at any other rank offers Launch Services a candidate
	     default handler for every file on the Mac: `Owner` and `Alternate` both
	     compete, and a utility that opened the user's documents instead of their
	     editor because it once claimed `public.data` is a support incident, not a
	     feature. `None` means "never propose me, but honour an explicit choice" —
	     the drop and the Open With still work, and nothing changes for a
	     double-click.

	     `Viewer`, not `Editor`: Relayium never writes back to what it is given.
	     It reads the bytes, encrypts them and sends them; the original file is
	     untouched, and `Editor` would additionally make this app a candidate for
	     "revert to" and document-restore behaviour it does not implement.

	     `CFBundleTypeName` is not localized. At rank `None` it is not surfaced in
	     the places a type name is read — the Kind column and Get Info both keep
	     answering with the real owner's name — so nine InfoPlist.strings would be
	     nine translations of a string this app never displays. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>File or folder to send</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://relayium.com/apps/macos/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>AoA0oNo2cZzjIJ4CJgnaFUhy3EAucSxcM+/iayLux6k=</string>
</dict>
</plist>
