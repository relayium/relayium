# Relayium server configuration (copy to .env and edit).
#
# Every CLI flag has a RELAYIUM_* fallback. Precedence, highest first:
#   1. explicit CLI flag (e.g. -admin-pass ...)
#   2. a real environment variable
#   3. this .env file
#   4. the built-in default
#
# .env is git-ignored; never commit real secrets. Point at a different file
# with RELAYIUM_ENV_FILE=/path/to/file (a real env var, not set here).

# --- Admin dashboard ---
# Credentials for the /admin console. NOT read-only: besides the user list and
# a read-only audit log, it can edit site settings, billing plans, user plans,
# mint/revoke node tokens, and control rollouts. Treat the password like a
# production secret. Username defaults to "admin" if unset. Password empty
# disables /admin entirely.
RELAYIUM_ADMIN_USER=admin
RELAYIUM_ADMIN_PASS=

# 管理员双因素认证(TOTP)。留空 = 关闭,仅账号+密码登录。
# 生成密钥:在 server/ 下运行  go run . -gen-admin-totp  ,扫码后把 base32 密钥填在这里并重启。
# 详见 docs/self-hosting.md 的 "Admin dashboard" 一节。
RELAYIUM_ADMIN_TOTP_SECRET=

# --- Core ---
# RELAYIUM_ADDR=:8080
# RELAYIUM_BASE_URL=http://localhost:8080
# RELAYIUM_DB=relayium.db
# RELAYIUM_STATIC=../web/dist

# Reverse-proxy trust for X-Forwarded-For (LAN room grouping + rate-limit keys).
# LOOPBACK IS ALWAYS TRUSTED, so a same-host nginx/Caddy → 127.0.0.1:8080 needs
# NOTHING here. Set this ONLY when the proxy reaches the server from a
# NON-loopback address (container bridge IP, separate LB host); otherwise the
# server ignores XFF and every visitor lands in one shared "127.0.0.1" LAN room.
# Comma-separated CIDRs or IPs, e.g. 172.18.0.0/16 or 10.0.0.5.
# RELAYIUM_TRUSTED_PROXIES=

# --- Login methods (off by default; the code is preserved) ---
# RELAYIUM_ENABLE_GOOGLE=false
# RELAYIUM_ENABLE_MAGIC=false
# RELAYIUM_GOOGLE_ID=
# RELAYIUM_GOOGLE_SECRET=

# --- Sign in with Apple (off by default) — setup notes live in the private relayium-ops repo ---
# RELAYIUM_ENABLE_APPLE=false
# aud allowlist: MUST contain BOTH the native app's Bundle ID and the web
# Services ID, comma-separated.
# RELAYIUM_APPLE_CLIENT_IDS=com.relayium.app,com.relayium.web
# Web client_id (the Services ID). Leave unset to keep web Sign in with
# Apple off while native stays on.
# RELAYIUM_APPLE_SERVICES_ID=com.relayium.web
# client_secret issuer/signing identity.
# RELAYIUM_APPLE_TEAM_ID=XXXXXXXXXX
# RELAYIUM_APPLE_KEY_ID=XXXXXXXXXX
# Path to the downloaded .p8 private key, placed on the host.
# RELAYIUM_APPLE_PRIVATE_KEY_FILE=/etc/relayium/apple_signin.p8
# Path to the domain-association proof file.
# RELAYIUM_APPLE_DOMAIN_ASSOC_FILE=/etc/relayium/apple-developer-domain-association.txt

# --- SMTP ---
# Powers email verification and password reset (always active) plus the
# optional magic-link login above. Whenever RELAYIUM_SMTP_ADDR is set, the
# server emails these links; otherwise it logs them to stdout (dev only).
# RELAYIUM_SMTP_ADDR=
# RELAYIUM_SMTP_FROM=noreply@relayium.com
# RELAYIUM_SMTP_USER=
# RELAYIUM_SMTP_PASS=

# --- Stripe (paid plans) ---
# Empty secret key = billing is inert: /api/billing/* and /api/stripe/webhook
# all 404 and the upgrade buttons disappear. Going live is Stripe-account-
# specific (dashboard webhook registration, live Price ids) and not covered
# in the public docs; relayium.com's own setup notes live in the private
# relayium-ops repo. Self-hosters can wire their own Stripe account by
# following Stripe's webhook + Billing Portal docs directly.
#
# The keys below are per-mode: a test-mode key only ever sees test-mode
# customers and prices. Switching test -> live means replacing BOTH values AND
# re-entering live Price ids in /admin — the ids do not carry across modes.
# RELAYIUM_STRIPE_SECRET_KEY=sk_live_...
# Signing secret of the webhook endpoint registered for THIS mode. A test-mode
# whsec against live traffic makes every webhook fail signature verification,
# which silently means no one ever gets upgraded.
# RELAYIUM_STRIPE_WEBHOOK_SECRET=whsec_...
# Optional. Empty uses the account's default Billing Portal configuration.
# RELAYIUM_STRIPE_PORTAL_CONFIG=bpc_...

# --- TURN / STUN / metering ---
# RELAYIUM_TURN_SECRET=
# RELAYIUM_TURN_URLS=
# RELAYIUM_STUN_URLS=stun:stun.l.google.com:19302
# RELAYIUM_REDIS_ADDR=
