# Relayium server configuration (copy to .env and edit).
#
# Every CLI flag has a RELAYIUM_* fallback. Precedence, highest first:
#   1. explicit CLI flag (e.g. -admin-pass ...)
#   2. a real environment variable
#   3. this .env file
#   4. the built-in default
#
# .env is git-ignored; never commit real secrets. Point at a different file
# with RELAYIUM_ENV_FILE=/path/to/file (a real env var, not set here).

# --- Admin dashboard ---
# Credentials for the /admin console. NOT read-only: besides the user list and
# a read-only audit log, it can edit site settings, billing plans, user plans,
# mint/revoke node tokens, and control rollouts. Treat the password like a
# production secret. Username defaults to "admin" if unset. Password empty
# disables /admin entirely.
RELAYIUM_ADMIN_USER=admin
RELAYIUM_ADMIN_PASS=

# 管理员双因素认证(TOTP)。留空 = 关闭,仅账号+密码登录。
# 生成密钥:在 server/ 下运行  go run . -gen-admin-totp  ,扫码后把 base32 密钥填在这里并重启。
# 详见 docs/self-hosting.md 的 "Admin dashboard" 一节。
RELAYIUM_ADMIN_TOTP_SECRET=

# --- Core ---
# RELAYIUM_ADDR=:8080
# RELAYIUM_BASE_URL=http://localhost:8080
# RELAYIUM_DB=relayium.db
# RELAYIUM_STATIC=../web/dist

# Reverse-proxy trust for X-Forwarded-For (LAN room grouping + rate-limit keys).
# LOOPBACK IS ALWAYS TRUSTED, so a same-host nginx/Caddy → 127.0.0.1:8080 needs
# NOTHING here. Set this ONLY when the proxy reaches the server from a
# NON-loopback address (container bridge IP, separate LB host); otherwise the
# server ignores XFF and every visitor lands in one shared "127.0.0.1" LAN room.
# Comma-separated CIDRs or IPs, e.g. 172.18.0.0/16 or 10.0.0.5.
# RELAYIUM_TRUSTED_PROXIES=

# --- Login methods (off by default; the code is preserved) ---
# RELAYIUM_ENABLE_GOOGLE=false
# RELAYIUM_ENABLE_MAGIC=false
# RELAYIUM_GOOGLE_ID=
# RELAYIUM_GOOGLE_SECRET=

# --- Sign in with Apple (off by default) — setup notes live in the private relayium-ops repo ---
# RELAYIUM_ENABLE_APPLE=false
# aud allowlist: MUST contain BOTH the native app's Bundle ID and the web
# Services ID, comma-separated.
# RELAYIUM_APPLE_CLIENT_IDS=com.relayium.app,com.relayium.web
# Web client_id (the Services ID). Leave unset to keep web Sign in with
# Apple off while native stays on.
# RELAYIUM_APPLE_SERVICES_ID=com.relayium.web
# client_secret issuer/signing identity.
# RELAYIUM_APPLE_TEAM_ID=XXXXXXXXXX
# RELAYIUM_APPLE_KEY_ID=XXXXXXXXXX
# Path to the downloaded .p8 private key, placed on the host.
# RELAYIUM_APPLE_PRIVATE_KEY_FILE=/etc/relayium/apple_signin.p8
# Path to the domain-association proof file.
# RELAYIUM_APPLE_DOMAIN_ASSOC_FILE=/etc/relayium/apple-developer-domain-association.txt

# --- App Store purchases (StoreKit transaction intake; OFF by default) ---
# SEPARATE from Sign in with Apple above and shares none of its values: no Team
# ID, no Key ID, no .p8, no client secret. This one variable is the whole
# switch, and its default (unset) is what every deployment runs today:
#
#   unset  -> no verifier is built, and POST /api/billing/apple/transaction
#             answers 503 {"error":"verifier_unavailable"}. Nothing else changes.
#   set    -> the file must exist and be complete, or THE SERVER REFUSES TO
#             START. A typo is a failed boot, never a purchase path that looks
#             live and answers 503 forever.
#
# The file is JSON you create on the host — no product ids, no secrets:
#
#   {
#     "environment": "Sandbox",
#     "rootCertsFile": "/etc/relayium/apple-root-cas.pem",
#     "apps": [
#       {"bundleId": "com.example.app", "appAppleId": 0},
#       {"bundleId": "com.example.mac", "appAppleId": 0}
#     ]
#   }
#
#   environment    "Sandbox" or "Production", exactly. This is YOUR answer to
#                  which App Store this deployment talks to; it is never read
#                  from the submitted transaction. Sandbox purchases are free,
#                  so a Production deployment on "Sandbox" gives paid tiers away.
#   apps           one entry per App Store record — the macOS and iOS builds are
#                  two apps, never one merged entry. appAppleId is the numeric
#                  App Store id ("Apple ID" in App Store Connect); it is
#                  REQUIRED (non-zero) when environment is "Production".
#   rootCertsFile  ABSOLUTE path to a PEM file holding the Apple root CA(s) you
#                  downloaded from Apple. ROOTS ONLY: Apple lists intermediates
#                  on the same page, and a certificate that has not signed
#                  itself is refused at startup rather than becoming a trust
#                  anchor of its own. Explicit trust anchors: the system root
#                  store is never used, and the certificate chain inside a
#                  submitted transaction is never trusted to anchor itself.
#
# Both files belong to the server's own user, mode 0600 (0640 if a group needs
# to read them), and neither is committed. Regular files only — a symlink, a
# directory or a FIFO in either path is refused at startup.
#
# UNDER DOCKER both paths are resolved INSIDE the container, which mounts only
# /data: files left on the host are invisible there and the container refuses
# to boot. Bind-mount both read-only at the same absolute paths and give them
# to uid/gid 65532 — see "App Store purchases" in docs/self-hosting.md.
#
# ORDER OF ACTIVATION. The bundle+product -> plan/cycle mappings (the Apple
# product catalog in the database) must ALREADY EXIST before any client is
# allowed to purchase: this file does not define products, and a verified
# transaction for an unmapped product is refused AFTER the customer's money has
# moved. Create the mappings first, then set this variable, then restart, then
# ship the client.
#
# ROLLBACK, IN THIS ORDER: comment this variable out (or delete the line) and
# restart. The endpoint goes back to 503 and nothing else in the server
# changes. Only AFTER the variable is unset may the JSON and PEM files be
# removed — a path that is still SET but missing is a fatal startup error, so
# deleting the files first turns a rollback into a server that refuses to boot.
# RELAYIUM_APPLE_STORE_CONFIG_FILE=/etc/relayium/apple-store.json
# RELAYIUM_APPLE_SERVER_API_ISSUER_ID=
# RELAYIUM_APPLE_SERVER_API_KEY_ID=
# RELAYIUM_APPLE_SERVER_API_PRIVATE_KEY_FILE=/etc/relayium/apple-subscription-api.p8

# --- SMTP ---
# Powers email verification and password reset (always active) plus the
# optional magic-link login above. Whenever RELAYIUM_SMTP_ADDR is set, the
# server emails these links; otherwise it logs them to stdout (dev only).
# RELAYIUM_SMTP_ADDR=
# RELAYIUM_SMTP_FROM=noreply@relayium.com
# RELAYIUM_SMTP_USER=
# RELAYIUM_SMTP_PASS=

# --- Stripe (paid plans) ---
# Empty secret key = billing is inert: /api/billing/* and /api/stripe/webhook
# all 404 and the upgrade buttons disappear. Going live is Stripe-account-
# specific (dashboard webhook registration, live Price ids) and not covered
# in the public docs; relayium.com's own setup notes live in the private
# relayium-ops repo. Self-hosters can wire their own Stripe account by
# following Stripe's webhook + Billing Portal docs directly.
#
# The keys below are per-mode: a test-mode key only ever sees test-mode
# customers and prices. Switching test -> live means replacing BOTH values AND
# re-entering live Price ids in /admin — the ids do not carry across modes.
# RELAYIUM_STRIPE_SECRET_KEY=sk_live_...
# Signing secret of the webhook endpoint registered for THIS mode. A test-mode
# whsec against live traffic makes every webhook fail signature verification,
# which silently means no one ever gets upgraded.
# RELAYIUM_STRIPE_WEBHOOK_SECRET=whsec_...
# Required whenever Stripe is enabled. Relayium fails closed without a dedicated
# Portal configuration whose subscription updates are disabled and whose
# cancellation mode is at period end; never use the account default.
# RELAYIUM_STRIPE_PORTAL_CONFIG=bpc_...
# Required whenever Stripe or Apple subscription billing is enabled. Keep this
# stable: it HMACs the bounded post-deletion billing hold used to prevent a
# deleted account from reopening a second provider purchase path.
# RELAYIUM_BILLING_HOLD_SECRET=

# --- TURN / STUN / metering ---
# RELAYIUM_TURN_SECRET=
# RELAYIUM_TURN_URLS=
# RELAYIUM_STUN_URLS=stun:stun.l.google.com:19302
# RELAYIUM_REDIS_ADDR=
