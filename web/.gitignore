node_modules
dist
dist-ssr
*.local

# Left behind by the retired `build:link-e2e` script: link/1 used to need its own
# bundle. It is now a property of the default build, scoped to the LAN room, so
# there is nothing to build separately — but an old checkout may still have one.
dist-link-e2e
# Browser evidence from `e2e/mixed-link.mjs --screenshots`.
e2e-screenshots
# Machine-readable inventory from `e2e/a11y-scan.mjs --json`. The pass/fail
# verdict is the allowlist, not a checked-in snapshot of findings. Glob so the
# per-run names (a11y-report-fixed.json, …) are covered too.
a11y-report*.json

